# Supabase project configuration (required to run database migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. When set, BitbyBit uses OpenAI vision to read receipt and statement photos,
# and suggests tags for movements the built-in merchant rules cannot classify.
# Never prefix this with NEXT_PUBLIC_ — it must stay server-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. The public origin, used for absolute og:image and canonical URLs.
# Leave unset locally; set it on the deployment (e.g. https://bitbybit.example).
NEXT_PUBLIC_SITE_URL=
