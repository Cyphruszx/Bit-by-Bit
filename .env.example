# Supabase project configuration (required for sign-in and cloud persist).
# Use the publishable (anon) key only. Never put the service_role key in this file
# or any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. When set, BitbyBit uses OpenAI vision to read receipt and statement photos,
# and suggests tags for movements the built-in merchant rules cannot classify.
# Never prefix this with NEXT_PUBLIC_ — it must stay server-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
