# Supabase project configuration (required to run database migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Open Banking jobs (Connect sync, webhooks, poll) write the same
# public.ledgers document the signed-in UI reads. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. When set, BitbyBit uses OpenAI vision to read receipt and statement photos,
# and suggests tags for movements the built-in merchant rules cannot classify.
# Never prefix this with NEXT_PUBLIC_ — it must stay server-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Fiskil Data API (Spec 12 Open Banking). Server-only — used to mint an app token
# and create/link end users. Already set as sensitive env on Vercel.
# Never prefix this with NEXT_PUBLIC_ — it must stay server-only.
FISKIL_CLIENT_ID=
FISKIL_CLIENT_SECRET=
# HMAC secret from the Fiskil Console webhook registration (base64).
FISKIL_WEBHOOK_SECRET=
